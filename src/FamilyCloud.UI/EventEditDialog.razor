@* Thin MudDialog wrapper around EventEditForm — the actual HTTP call happens after the dialog
   closes, in whatever page opened it (see EventEditForm's own doc comment for why). *@

<MudDialog>
    <DialogContent>
        <EventEditForm ExistingEvent="ExistingEvent" WritableCalendars="WritableCalendars" OnSave="HandleSave" OnDelete="HandleDelete" OnCancel="Cancel" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public EventDto? ExistingEvent { get; set; }
    [Parameter] public IReadOnlyList<CalendarDto> WritableCalendars { get; set; } = [];

    private void Cancel() => MudDialog.Cancel();

    private void HandleSave((Guid? CalendarId, EventWriteRequest Request) save) =>
        MudDialog.Close(DialogResult.Ok(new EventEditDialogResult(EventEditDialogAction.Save, save.Request, save.CalendarId)));

    private void HandleDelete() =>
        MudDialog.Close(DialogResult.Ok(new EventEditDialogResult(EventEditDialogAction.Delete)));
}
