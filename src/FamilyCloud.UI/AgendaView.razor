@* Host-agnostic event list: takes already-loaded events and renders them grouped by day.
   No HTTP calls here — the host (server admin page or MAUI app) owns fetching. *@

@if (Events.Count == 0)
{
    <MudText Typo="Typo.body1" Class="pa-4" Align="Align.Center">Keine Termine im gewählten Zeitraum.</MudText>
}
else
{
    @foreach (var day in GroupedByDay)
    {
        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1 mud-text-secondary">@day.Key.ToString("dddd, d. MMMM yyyy")</MudText>
        <MudList T="EventDto">
            @foreach (var evt in day)
            {
                <MudListItem T="EventDto" OnClick="() => OnEventClick.InvokeAsync(evt)">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <div style="width:4px; align-self:stretch; border-radius:2px; background-color:@ColorFor(evt);"></div>
                        <div style="flex:1;">
                            <MudText Typo="Typo.body1">@evt.Summary</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @TimeRangeFor(evt)
                                @if (!string.IsNullOrWhiteSpace(evt.Location))
                                {
                                    @($" · {evt.Location}")
                                }
                            </MudText>
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EventDto> Events { get; set; } = [];
    [Parameter] public IReadOnlyList<CalendarDto> Calendars { get; set; } = [];
    [Parameter] public EventCallback<EventDto> OnEventClick { get; set; }

    private IEnumerable<IGrouping<DateOnly, EventDto>> GroupedByDay =>
        Events
            .OrderBy(e => e.StartUtc)
            .SelectMany(e => DaysSpanned(e).Select(day => (Day: day, Event: e)))
            .GroupBy(x => x.Day, x => x.Event);

    /// <summary>Every local day an event should appear on. Timed events and single-day all-day events
    /// span just their start day; a multi-day all-day event's EndUtc is the RFC 5545 exclusive end
    /// (day after the last day), so it's spanned up to but not including that day.</summary>
    private static IEnumerable<DateOnly> DaysSpanned(EventDto evt)
    {
        var startDay = DateOnly.FromDateTime(evt.StartUtc.LocalDateTime);
        if (!evt.IsAllDay || evt.EndUtc is not { } endUtc)
        {
            yield return startDay;
            yield break;
        }

        var lastDay = DateOnly.FromDateTime(endUtc.LocalDateTime).AddDays(-1);
        for (var day = startDay; day <= lastDay; day = day.AddDays(1))
        {
            yield return day;
        }
    }

    private string TimeRangeFor(EventDto evt)
    {
        if (evt.IsAllDay)
        {
            return "Ganztägig";
        }

        var start = evt.StartUtc.LocalDateTime.ToString("HH:mm");
        var end = evt.EndUtc?.LocalDateTime.ToString("HH:mm");
        return end is null ? start : $"{start} – {end}";
    }

    private string ColorFor(EventDto evt)
    {
        var calendar = Calendars.FirstOrDefault(c => c.Id == evt.CalendarId);
        return string.IsNullOrWhiteSpace(calendar?.ColorHex) ? "var(--mud-palette-primary)" : calendar.ColorHex;
    }
}
