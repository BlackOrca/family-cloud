<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FamilyCloud.Contracts\FamilyCloud.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FamilyCloud.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only what AppUser (an IdentityUser<Guid>), SyncEventPublisher (the abstract EF Core DbContext)
         and ClaimsPrincipalExtensions (JwtRegisteredClaimNames) need. The composed
         FamilyCloudDbContext, its provider, and every feature-specific package (Ical.Net, BCrypt,
         Data Protection) live with the project that actually owns them now — see the Phase 1
         architecture roadmap. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
