@page "/login"
@implements IDisposable

<div class="auth-background pt-8">
    <MudContainer MaxWidth="MaxWidth.Small">
        <LoginFormCard Title="@TitleState.Title" @bind-UserName="_userName" @bind-Password="_password"
                       IsBusy="_isBusy" ErrorMessage="@_errorMessage" OnSubmit="HandleLoginAsync" />
        <div class="d-flex justify-center mt-2">
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Nav.NavigateTo("/setup"))">Server ändern</MudButton>
        </div>
    </MudContainer>
</div>

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthTokenStore TokenStore { get; set; } = default!;
    [Inject] private AppAuthState AuthState { get; set; } = default!;
    [Inject] private AppTitleState TitleState { get; set; } = default!;
    [Inject] private ServerAddressStore AddressStore { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string _userName = "";
    private string _password = "";
    private bool _isBusy;
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        if (AddressStore.Load() is null)
        {
            Nav.NavigateTo("/setup", replace: true);
        }

        TitleState.Changed += OnTitleChanged;
    }

    private void OnTitleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => TitleState.Changed -= OnTitleChanged;

    private async Task HandleLoginAsync((string UserName, string Password) credentials)
    {
        _isBusy = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var result = await Api.LoginAsync(credentials.UserName, credentials.Password);
            if (result is null)
            {
                _errorMessage = "Benutzername oder Passwort ist falsch.";
                return;
            }

            await TokenStore.SaveAsync(result.Token, result.ExpiresUtc, result.DisplayName);
            AuthState.SetLoggedIn(result.Token, result.DisplayName);
            Nav.NavigateTo("/", replace: true);
        }
        catch (Exception)
        {
            _errorMessage = "Server nicht erreichbar. Bitte später erneut versuchen.";
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }
}
