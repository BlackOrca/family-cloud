@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider Theme="FamilyCloudTheme.Default" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @if (AuthState.IsAuthenticated)
    {
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            <MudText Typo="Typo.h6" Class="ml-2">@TitleState.Title</MudText>
            <MudSpacer />
            <MudText Typo="Typo.body2" Class="mr-2">@AuthState.DisplayName</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Temporary" Anchor="Anchor.Start">
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.CalendarMonth" OnClick="@(() => _drawerOpen = false)">
                    Kalender
                </MudNavLink>
                <MudNavLink Href="/lists" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Checklist" OnClick="@(() => _drawerOpen = false)">
                    Listen
                </MudNavLink>
                <MudNavLink Href="/account" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountCircle" OnClick="@(() => _drawerOpen = false)">
                    Account
                </MudNavLink>
            </MudNavMenu>
        </MudDrawer>
    }

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    [Inject] private AppAuthState AuthState { get; set; } = default!;
    [Inject] private AppTitleState TitleState { get; set; } = default!;
    [Inject] private AuthTokenStore TokenStore { get; set; } = default!;
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private SyncCoordinator Sync { get; set; } = default!;

    private bool _isDarkMode;
    private bool _drawerOpen;
    private IDisposable? _settingsSub;

    protected override void OnInitialized()
    {
        AuthState.Changed += OnAuthChanged;
        TitleState.Changed += OnTitleChanged;
        _settingsSub = Sync.Subscribe(SyncResourceType.Settings, _ => LoadTitleAsync());
        _ = LoadTitleAsync();
    }

    private async Task LoadTitleAsync()
    {
        try
        {
            var settings = await Api.GetSettingsAsync();
            if (settings is not null)
            {
                TitleState.Set(settings.Title);
            }
        }
        catch (Exception)
        {
            // No server configured yet, or unreachable — keep the default title.
        }
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private void OnTitleChanged() => InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        TokenStore.Clear();
        AuthState.SetLoggedOut();
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        AuthState.Changed -= OnAuthChanged;
        TitleState.Changed -= OnTitleChanged;
        _settingsSub?.Dispose();
    }
}
