@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using FamilyCloud.Server.Data
@using FamilyCloud.Server.Services
@inject IDbContextFactory<FamilyCloudDbContext> DbFactory
@inject AppTitleNotifier TitleNotifier

<PageTitle>@_title</PageTitle>

<MudThemeProvider Theme="FamilyCloudTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudImage Src="images/familycloud-logo.svg" Height="28" Width="28" Class="mr-2" />
        <MudText Typo="Typo.h6">@_title Admin</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mr-4" Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                <form action="Account/Logout" method="post">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit">Abmelden</MudButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Persistent">
        <MudNavMenu>
            <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Benutzer</MudNavLink>
            <MudNavLink Href="/admin/families" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FamilyRestroom">Familie</MudNavLink>
            <MudNavLink Href="/admin/calendars" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CalendarMonth">Kalenderkonten</MudNavLink>
            <MudNavLink Href="/admin/permissions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Lock">Berechtigungen</MudNavLink>
            <MudNavLink Href="/admin/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">Einstellungen</MudNavLink>
            <MudNavLink Href="/account" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountCircle">Mein Account</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private string _title = "FamilyCloud";

    protected override async Task OnInitializedAsync()
    {
        await LoadTitleAsync();
        TitleNotifier.Changed += OnTitleChanged;
    }

    private async Task LoadTitleAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _title = await db.AppSettings.Select(s => s.Title).FirstOrDefaultAsync() ?? "FamilyCloud";
    }

    private void OnTitleChanged() => InvokeAsync(async () =>
    {
        await LoadTitleAsync();
        StateHasChanged();
    });

    public void Dispose() => TitleNotifier.Changed -= OnTitleChanged;
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
