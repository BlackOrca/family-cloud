@page "/admin/calendars"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using FamilyCloud.Calendar.CalDav
@using FamilyCloud.Calendar.Domain
@using FamilyCloud.Calendar.Security
@using FamilyCloud.Calendar.Sync
@using FamilyCloud.Server.Data
@inject FamilyCloudDbContext Db
@inject CalendarSyncService SyncService
@inject ICalDavPasswordProtector PasswordProtector
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Kalenderkonten</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Kalenderkonten</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog" Class="mb-4">
    Neues Kalenderkonto
</MudButton>

@if (accounts is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (accounts.Count == 0)
{
    <MudAlert Severity="Severity.Info">Noch keine Kalenderkonten eingerichtet.</MudAlert>
}
else
{
    @foreach (var account in accounts)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <div class="d-flex align-center justify-space-between">
                <div>
                    <div class="d-flex align-center">
                        <MudText Typo="Typo.h6">@account.DisplayName</MudText>
                        @if (account.IsManaged)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">systemverwaltet</MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@account.BaseUrl (@account.Username)</MudText>
                    <MudText Typo="Typo.caption">
                        Zuletzt abgeglichen: @(account.LastDiscoveredUtc?.LocalDateTime.ToString("g") ?? "noch nie")
                    </MudText>
                </div>
                <div>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenCreateCalendarDialog(account))">
                        Neuer Kalender
                    </MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="@(() => RefreshCalendarsAsync(account))">
                        Kalender aktualisieren
                    </MudButton>
                    @if (!account.IsManaged)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAccountAsync(account))" />
                    }
                </div>
            </div>

            @if (account.Calendars.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mt-2">Keine Kalender gefunden.</MudText>
            }
            else
            {
                <MudList T="string" Class="mt-2">
                    @foreach (var calendar in account.Calendars)
                    {
                        <MudListItem T="string">
                            <div class="d-flex align-center justify-space-between">
                                <div class="d-flex align-center">
                                    @if (!string.IsNullOrWhiteSpace(calendar.ColorHex))
                                    {
                                        <div style="@($"width:12px;height:12px;border-radius:50%;background:{calendar.ColorHex};margin-right:8px;")"></div>
                                    }
                                    @calendar.DisplayName
                                    <MudText Typo="Typo.caption" Class="ml-2">
                                        (zuletzt synchronisiert: @(calendar.LastSyncedUtc?.LocalDateTime.ToString("g") ?? "noch nie"))
                                    </MudText>
                                </div>
                                <div>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditCalendarDialog(account, calendar))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteCalendarAsync(account, calendar))" />
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    }
}

@code {
    private List<CalendarAccount>? accounts;
    private Guid _familyId;

    protected override async Task OnInitializedAsync()
    {
        // Exactly one family exists today (see Program.cs's seed flow and the Phase 1 architecture
        // roadmap) — every newly discovered/created calendar belongs to it.
        _familyId = (await Db.Families.FirstAsync()).Id;
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        accounts = await Db.CalendarAccounts
            .Include(a => a.Calendars)
            .OrderBy(a => a.DisplayName)
            .ToListAsync();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateCalendarAccountDialog>("Neues Kalenderkonto");
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CreateCalendarAccountDialog.InputModel input)
        {
            return;
        }

        var account = new CalendarAccount
        {
            Id = Guid.NewGuid(),
            DisplayName = input.DisplayName,
            BaseUrl = input.BaseUrl,
            Username = input.Username,
            EncryptedAppPassword = PasswordProtector.Encrypt(input.Password),
            CreatedUtc = DateTimeOffset.UtcNow,
        };
        Db.CalendarAccounts.Add(account);
        await Db.SaveChangesAsync();

        await DiscoverAsync(account, input.Password);
        await LoadAccountsAsync();
    }

    private async Task RefreshCalendarsAsync(CalendarAccount account)
    {
        var password = PasswordProtector.Decrypt(account.EncryptedAppPassword);
        await DiscoverAsync(account, password);
        await LoadAccountsAsync();
    }

    private async Task DiscoverAsync(CalendarAccount account, string password)
    {
        try
        {
            await SyncService.DiscoverCalendarsAsync(account, _familyId, new CalDavCredentials(account.Username, password));
            Snackbar.Add($"Kalender für '{account.DisplayName}' aktualisiert.", Severity.Success);
        }
        catch (CalDavException ex)
        {
            Snackbar.Add($"Kalender-Abgleich fehlgeschlagen: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenCreateCalendarDialog(CalendarAccount account)
    {
        var dialog = await DialogService.ShowAsync<CalendarDialog>("Neuer Kalender");
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CalendarDialog.InputModel input)
        {
            return;
        }

        var password = PasswordProtector.Decrypt(account.EncryptedAppPassword);
        try
        {
            await SyncService.CreateCalendarAsync(account, _familyId, new CalDavCredentials(account.Username, password), input.DisplayName, NormalizeColor(input.ColorHex));
            Snackbar.Add($"Kalender '{input.DisplayName}' angelegt.", Severity.Success);
        }
        catch (CalDavException ex)
        {
            Snackbar.Add($"Kalender anlegen fehlgeschlagen: {ex.Message}", Severity.Error);
        }
        await LoadAccountsAsync();
    }

    private async Task OpenEditCalendarDialog(CalendarAccount account, Calendar calendar)
    {
        var parameters = new DialogParameters<CalendarDialog>
        {
            { x => x.InitialDisplayName, calendar.DisplayName },
            { x => x.InitialColorHex, calendar.ColorHex },
        };
        var dialog = await DialogService.ShowAsync<CalendarDialog>("Kalender bearbeiten", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CalendarDialog.InputModel input)
        {
            return;
        }

        var password = PasswordProtector.Decrypt(account.EncryptedAppPassword);
        try
        {
            await SyncService.UpdateCalendarAsync(account, calendar, new CalDavCredentials(account.Username, password), input.DisplayName, NormalizeColor(input.ColorHex));
            Snackbar.Add($"Kalender '{input.DisplayName}' aktualisiert.", Severity.Success);
        }
        catch (CalDavException ex)
        {
            Snackbar.Add($"Kalender aktualisieren fehlgeschlagen: {ex.Message}", Severity.Error);
        }
        await LoadAccountsAsync();
    }

    private async Task DeleteCalendarAsync(CalendarAccount account, Calendar calendar)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Kalender löschen",
            Message = $"'{calendar.DisplayName}' wirklich löschen? Alle zwischengespeicherten Termine und Berechtigungen für diesen Kalender gehen dabei verloren.",
            YesText = "Löschen",
            CancelText = "Abbrechen",
        });
        if (confirmed != true)
        {
            return;
        }

        var password = PasswordProtector.Decrypt(account.EncryptedAppPassword);
        try
        {
            await SyncService.DeleteCalendarAsync(account, calendar, new CalDavCredentials(account.Username, password));
            Snackbar.Add($"Kalender '{calendar.DisplayName}' gelöscht.", Severity.Success);
        }
        catch (CalDavException ex)
        {
            Snackbar.Add($"Kalender löschen fehlgeschlagen: {ex.Message}", Severity.Error);
        }
        await LoadAccountsAsync();
    }

    private static string? NormalizeColor(string? colorHex) => string.IsNullOrWhiteSpace(colorHex) ? null : colorHex;

    private async Task DeleteAccountAsync(CalendarAccount account)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(new MessageBoxOptions
        {
            Title = "Kalenderkonto löschen",
            Message = $"'{account.DisplayName}' wirklich löschen? Alle zugehörigen Kalender, Berechtigungen und zwischengespeicherten Termine gehen dabei verloren.",
            YesText = "Löschen",
            CancelText = "Abbrechen",
        });
        if (confirmed != true)
        {
            return;
        }

        Db.CalendarAccounts.Remove(account);
        await Db.SaveChangesAsync();
        Snackbar.Add($"Kalenderkonto '{account.DisplayName}' gelöscht.", Severity.Success);
        await LoadAccountsAsync();
    }
}
