@page "/admin/permissions"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using FamilyCloud.Calendar.Domain
@using FamilyCloud.Core.Data
@using FamilyCloud.Server.Data
@inject IDbContextFactory<FamilyCloudDbContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>Berechtigungen</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Berechtigungen</MudText>

@if (users is null || calendars is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (calendars.Count == 0)
{
    <MudAlert Severity="Severity.Info">Es sind noch keine Kalender vorhanden — zuerst ein Kalenderkonto anlegen.</MudAlert>
}
else if (users.Count == 0)
{
    <MudAlert Severity="Severity.Info">Es sind noch keine Benutzer vorhanden.</MudAlert>
}
else
{
    <MudTable Items="@users" Hover="true">
        <HeaderContent>
            <MudTh>Benutzer</MudTh>
            @foreach (var calendar in calendars)
            {
                <MudTh>@calendar.DisplayName<br /><MudText Typo="Typo.caption">@calendar.CalendarAccount?.DisplayName</MudText></MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Benutzer">@context.DisplayName</MudTd>
            @foreach (var calendar in calendars)
            {
                var userId = context.Id;
                var calendarId = calendar.Id;
                <MudTd>
                    <MudSelect T="string" Value="@GetAccessLevel(userId, calendarId)"
                               ValueChanged="@((string v) => SetAccessLevelAsync(userId, calendarId, v))"
                               Dense="true" Margin="Margin.Dense">
                        <MudSelectItem Value="@NoAccess">Kein Zugriff</MudSelectItem>
                        <MudSelectItem Value="@ReadAccess">Lesen</MudSelectItem>
                        <MudSelectItem Value="@WriteAccess">Lesen &amp; Schreiben</MudSelectItem>
                    </MudSelect>
                </MudTd>
            }
        </RowTemplate>
    </MudTable>
}

@code {
    private const string NoAccess = "none";
    private const string ReadAccess = "read";
    private const string WriteAccess = "write";

    private List<AppUser>? users;
    private List<Calendar>? calendars;
    private Dictionary<(Guid UserId, Guid CalendarId), CalendarPermission> permissions = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        users = await db.Users.OrderBy(u => u.DisplayName).ToListAsync();
        calendars = await db.Calendars.Include(c => c.CalendarAccount).OrderBy(c => c.DisplayName).ToListAsync();

        var existing = await db.CalendarPermissions.ToListAsync();
        permissions = existing.ToDictionary(p => (p.UserId, p.CalendarId));
    }

    private string GetAccessLevel(Guid userId, Guid calendarId)
    {
        if (!permissions.TryGetValue((userId, calendarId), out var permission))
        {
            return NoAccess;
        }
        return permission.CanWrite ? WriteAccess : ReadAccess;
    }

    private async Task SetAccessLevelAsync(Guid userId, Guid calendarId, string level)
    {
        var key = (userId, calendarId);
        permissions.TryGetValue(key, out var existing);

        await using var db = await DbFactory.CreateDbContextAsync();
        if (level == NoAccess)
        {
            if (existing is not null)
            {
                db.CalendarPermissions.Remove(existing);
                permissions.Remove(key);
            }
        }
        else
        {
            var canWrite = level == WriteAccess;
            if (existing is null)
            {
                existing = new CalendarPermission
                {
                    Id = Guid.NewGuid(),
                    UserId = userId,
                    CalendarId = calendarId,
                    CanWrite = canWrite,
                    GrantedUtc = DateTimeOffset.UtcNow,
                };
                db.CalendarPermissions.Add(existing);
                permissions[key] = existing;
            }
            else
            {
                existing.CanWrite = canWrite;
                db.CalendarPermissions.Update(existing);
            }
        }

        await db.SaveChangesAsync();
        Snackbar.Add("Berechtigung gespeichert.", Severity.Success);
    }
}
