@page "/admin/password"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using FamilyCloud.Core.Data
@using FamilyCloud.Core.Domain
@using FamilyCloud.Core.Security
@inject UserManager<AppUser> UserManager
@inject SignInManager<AppUser> SignInManager
@inject AuthenticationStateProvider AuthState
@inject FamilyCloudDbContext Db
@inject ICalDavPasswordProtector PasswordProtector
@inject IRadicaleCredentialProvisioner RadicaleProvisioner
@inject IConfiguration Configuration
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Passwort ändern</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Passwort ändern</MudText>

<MudPaper Class="pa-4" Elevation="2" Style="max-width: 480px;">
    <MudForm Model="@model" @ref="form">
        <MudTextField T="string" Label="Aktuelles Passwort" @bind-Value="model.CurrentPassword" InputType="InputType.Password"
                      Required="true" RequiredError="Pflichtfeld" />
        <MudTextField T="string" Label="Neues Passwort" @bind-Value="model.NewPassword" InputType="InputType.Password"
                      Required="true" RequiredError="Pflichtfeld" Class="mt-3" />
        <MudTextField T="string" Label="Neues Passwort bestätigen" @bind-Value="model.ConfirmPassword" InputType="InputType.Password"
                      Required="true" RequiredError="Pflichtfeld" Class="mt-3"
                      Validation="@(new Func<string, string?>(ConfirmPasswordMatches))" />
    </MudForm>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@errorMessage</MudAlert>
    }

    <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="SubmitAsync">
        Passwort ändern
    </MudButton>
</MudPaper>

@code {
    private MudForm form = default!;
    private readonly InputModel model = new();
    private string? errorMessage;

    [SupplyParameterFromQuery]
    private bool? PasswordChanged { get; set; }

    protected override void OnInitialized()
    {
        if (PasswordChanged == true)
        {
            Snackbar.Add("Passwort geändert.", Severity.Success);
        }
    }

    private string? ConfirmPasswordMatches(string confirmPassword) =>
        confirmPassword == model.NewPassword ? null : "Passwörter stimmen nicht überein.";

    private async Task SubmitAsync()
    {
        await form.ValidateAsync();
        if (!form.IsValid)
        {
            return;
        }

        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var user = userId is null ? null : await UserManager.FindByIdAsync(userId);
        if (user is null)
        {
            errorMessage = "Benutzer konnte nicht ermittelt werden.";
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, model.CurrentPassword, model.NewPassword);
        if (!result.Succeeded)
        {
            errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            return;
        }

        errorMessage = null;

        // Keep the bundled Radicale instance's credential in lockstep with the one FamilyCloud account it
        // mirrors — see the seed-time provisioning in Program.cs for why only that account propagates.
        // Program.cs only ever creates this account once, for the very first admin on an empty database
        // — anyone else (or an admin whose managed account got deleted) would otherwise have no way to
        // get one, so create it here on first password change instead of silently skipping.
        var managedAccount = await Db.CalendarAccounts.FirstOrDefaultAsync(a => a.IsManaged && a.Username == user.UserName);
        await RadicaleProvisioner.ProvisionAsync(user.UserName!, model.NewPassword);
        if (managedAccount is not null)
        {
            managedAccount.EncryptedAppPassword = PasswordProtector.Encrypt(model.NewPassword);
        }
        else
        {
            var radicaleBaseUrl = Configuration["Radicale:BaseUrl"] ?? "http://radicale:5232/";
            Db.CalendarAccounts.Add(new CalendarAccount
            {
                Id = Guid.NewGuid(),
                DisplayName = "Radicale (integriert)",
                BaseUrl = radicaleBaseUrl,
                Username = user.UserName!,
                EncryptedAppPassword = PasswordProtector.Encrypt(model.NewPassword),
                IsManaged = true,
                CreatedUtc = DateTimeOffset.UtcNow,
            });
        }
        await Db.SaveChangesAsync();

        // Changing the password rotates the security stamp; refresh the cookie so the admin isn't
        // immediately signed out by their own password change. That has to happen via a full page
        // navigation to a plain HTTP endpoint (see /Account/RefreshSignIn) — from here, inside the
        // interactive circuit, the response has already started and writing Set-Cookie would throw.
        var returnUrl = Uri.EscapeDataString("admin/password?passwordChanged=true");
        NavigationManager.NavigateTo($"Account/RefreshSignIn?returnUrl={returnUrl}", forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required]
        public string CurrentPassword { get; set; } = "";

        [Required]
        public string NewPassword { get; set; } = "";

        [Required]
        public string ConfirmPassword { get; set; } = "";
    }
}
