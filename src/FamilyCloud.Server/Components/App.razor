<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="_content/FamilyCloud.UI/FamilyCloud.UI.bundle.scp.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["FamilyCloud.Server.styles.css"]" />
    <link rel="icon" type="image/svg+xml" href="images/familycloud-logo.svg" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Pages marked [ExcludeFromInteractiveRouting] (the Identity Account pages — see
    // Account/Pages/_Imports.razor) need HttpContext, which is only available during static SSR.
    // Hard-coding InteractiveServer here would still spin up a circuit for them, which fails
    // silently and renders NotFound instead (https://github.com/dotnet/aspnetcore/issues/65652).
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
