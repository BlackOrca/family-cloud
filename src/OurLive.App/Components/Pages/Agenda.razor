@page "/"
@implements IDisposable

@if (_isLoading)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 d-flex justify-center">
        <MudProgressCircular Indeterminate="true" />
    </MudContainer>
}
else if (AuthState.IsAuthenticated)
{
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">OurLive</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-2">@AuthState.DisplayName</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" />
    </MudAppBar>

    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
        @if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-2">
                @_loadError
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="ml-2" OnClick="RetryLoadAsync">Erneut versuchen</MudButton>
            </MudAlert>
        }
        else if (_calendars.Count == 0)
        {
            <MudAlert Severity="Severity.Info">Für dich sind noch keine Kalender freigegeben.</MudAlert>
        }
        else
        {
            @if (_calendars.Count > 1)
            {
                <MudExpansionPanels Class="mb-2">
                    <MudExpansionPanel Text="Kalender">
                        <CalendarMultiSelect Calendars="_calendars" SelectedIds="_selectedCalendarIds"
                                              SelectedIdsChanged="OnSelectionChangedAsync" />
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }

            <AgendaView Events="_events" Calendars="_calendars" OnEventClick="OpenEditDialogAsync" />
        }
    </MudContainer>

    @if (_calendars.Any(c => c.CanWrite))
    {
        <div style="position:fixed; bottom:24px; right:24px;">
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync" />
        </div>
    }
}

@code {
    [Inject] private ApiClient Api { get; set; } = default!;
    [Inject] private AuthTokenStore TokenStore { get; set; } = default!;
    [Inject] private AppAuthState AuthState { get; set; } = default!;
    [Inject] private ServerAddressStore AddressStore { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private const string ServerUnreachableMessage = "Server nicht erreichbar. Bitte später erneut versuchen.";

    private bool _isLoading = true;
    private List<CalendarDto> _calendars = [];
    private List<EventDto> _events = [];
    private HashSet<Guid> _selectedCalendarIds = [];
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        AuthState.Changed += OnAuthChanged;

        if (AddressStore.Load() is null)
        {
            _isLoading = false;
            Nav.NavigateTo("/setup", replace: true);
            return;
        }

        if (!AuthState.IsAuthenticated)
        {
            var loaded = await TokenStore.LoadAsync();
            if (loaded is { } session)
            {
                AuthState.SetLoggedIn(session.Token, session.DisplayName);
            }
        }

        if (!AuthState.IsAuthenticated)
        {
            _isLoading = false;
            Nav.NavigateTo("/login", replace: true);
            return;
        }

        await LoadCalendarsAndEventsAsync();
        _isLoading = false;
    }

    private async Task LoadCalendarsAndEventsAsync()
    {
        try
        {
            _loadError = null;
            _calendars = await Api.GetCalendarsAsync();
            _selectedCalendarIds = _calendars.Select(c => c.Id).ToHashSet();
            await ReloadEventsAsync();
        }
        catch (Exception)
        {
            _loadError = ServerUnreachableMessage;
        }
    }

    private async Task RetryLoadAsync()
    {
        _isLoading = true;
        StateHasChanged();
        await LoadCalendarsAndEventsAsync();
        _isLoading = false;
    }

    private async Task OnSelectionChangedAsync(HashSet<Guid> selectedIds)
    {
        _selectedCalendarIds = selectedIds;
        try
        {
            await ReloadEventsAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(ServerUnreachableMessage, Severity.Error);
        }
        StateHasChanged();
    }

    private async Task ReloadEventsAsync()
    {
        var results = await Task.WhenAll(_selectedCalendarIds.Select(id => Api.GetEventsAsync(id)));
        _events = results.SelectMany(e => e).OrderBy(e => e.StartUtc).ToList();
    }

    private async Task OpenCreateDialogAsync()
    {
        var writableCalendarId = _calendars.FirstOrDefault(c => c.CanWrite)?.Id;
        if (writableCalendarId is not { } calendarId)
        {
            return;
        }

        var dialog = await DialogService.ShowAsync<EventEditDialog>("Neuer Termin");
        var dialogResult = await dialog.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not EventEditDialogResult { Action: EventEditDialogAction.Save } result)
        {
            return;
        }

        try
        {
            var writeResult = await Api.CreateEventAsync(calendarId, result.Request!);
            await HandleWriteResultAsync(writeResult, "erstellt");
        }
        catch (Exception)
        {
            Snackbar.Add(ServerUnreachableMessage, Severity.Error);
        }
    }

    private async Task OpenEditDialogAsync(EventDto evt)
    {
        var parameters = new DialogParameters<EventEditDialog> { { x => x.ExistingEvent, evt } };
        var dialog = await DialogService.ShowAsync<EventEditDialog>("Termin bearbeiten", parameters);
        var dialogResult = await dialog.Result;
        if (dialogResult is null || dialogResult.Canceled || dialogResult.Data is not EventEditDialogResult result)
        {
            return;
        }

        try
        {
            var writeResult = result.Action == EventEditDialogAction.Delete
                ? await Api.DeleteEventAsync(evt.Id)
                : await Api.UpdateEventAsync(evt.Id, result.Request!);

            await HandleWriteResultAsync(writeResult, result.Action == EventEditDialogAction.Delete ? "gelöscht" : "gespeichert");
        }
        catch (Exception)
        {
            Snackbar.Add(ServerUnreachableMessage, Severity.Error);
        }
    }

    private async Task HandleWriteResultAsync(EventWriteResult result, string successVerb)
    {
        switch (result.Outcome)
        {
            case EventWriteOutcome.Success:
                Snackbar.Add($"Termin {successVerb}.", Severity.Success);
                await ReloadEventsAsync();
                StateHasChanged();
                break;
            case EventWriteOutcome.Conflict:
                Snackbar.Add("Der Termin wurde zwischenzeitlich anderweitig geändert. Bitte neu laden.", Severity.Warning);
                await ReloadEventsAsync();
                StateHasChanged();
                break;
            case EventWriteOutcome.Forbidden:
                Snackbar.Add("Keine Schreibberechtigung für diesen Kalender.", Severity.Error);
                break;
            case EventWriteOutcome.NotFound:
                Snackbar.Add("Termin wurde nicht gefunden — evtl. bereits gelöscht.", Severity.Warning);
                await ReloadEventsAsync();
                StateHasChanged();
                break;
            default:
                Snackbar.Add("Speichern fehlgeschlagen. Bitte später erneut versuchen.", Severity.Error);
                break;
        }
    }

    private async Task LogoutAsync()
    {
        TokenStore.Clear();
        AuthState.SetLoggedOut();
        await Task.CompletedTask;
    }

    private void OnAuthChanged()
    {
        InvokeAsync(() =>
        {
            if (!AuthState.IsAuthenticated)
            {
                Nav.NavigateTo("/login", replace: true);
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthState.Changed -= OnAuthChanged;
    }
}
