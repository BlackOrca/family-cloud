@* Shared create/edit form for a single, non-recurring event. Host owns the actual HTTP call and
   passes the current event (edit mode) or nothing (create mode) plus save/delete/cancel callbacks —
   this component only collects input. Multi-day timed events and recurrence authoring are out of
   scope; a single date with an optional start/end time (or a contiguous all-day date range) is what
   a household needs. *@

<MudForm @ref="_form" Model="this">
    @if (ExistingEvent is null && WritableCalendars.Count > 1)
    {
        <MudSelect T="Guid" @bind-Value="_calendarId" Label="Kalender" Required="true" RequiredError="Kalender wird benötigt" Disabled="IsBusy">
            @foreach (var calendar in WritableCalendars)
            {
                <MudSelectItem T="Guid" Value="calendar.Id">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <div style="width:12px; height:12px; border-radius:50%; background-color:@(string.IsNullOrWhiteSpace(calendar.ColorHex) ? "var(--mud-palette-primary)" : calendar.ColorHex);"></div>
                        <MudText>@calendar.DisplayName</MudText>
                    </div>
                </MudSelectItem>
            }
        </MudSelect>
    }
    <MudTextField T="string" @bind-Value="_summary" Label="Titel" Required="true" RequiredError="Titel wird benötigt" Disabled="IsBusy" Class="mt-2" />
    <MudTextField T="string" @bind-Value="_location" Label="Ort" Class="mt-2" Disabled="IsBusy" />
    <MudTextField T="string" @bind-Value="_description" Label="Beschreibung" Lines="3" Class="mt-2" Disabled="IsBusy" />
    <MudCheckBox T="bool" Value="_isAllDay" ValueChanged="OnIsAllDayChanged" Label="Ganztägig" Class="mt-2" Disabled="IsBusy" />
    @if (_isAllDay)
    {
        <MudDateRangePicker @bind-DateRange="_dateRange" Label="Datum" Required="true" RequiredError="Datum wird benötigt" Class="mt-2" Disabled="IsBusy" />
    }
    else
    {
        <MudDatePicker @bind-Date="_date" Label="Datum" Required="true" RequiredError="Datum wird benötigt" Class="mt-2" Disabled="IsBusy" />
        <MudTimePicker @bind-Time="_startTime" Label="Startzeit" Required="true" RequiredError="Startzeit wird benötigt" Class="mt-2" Disabled="IsBusy" />
        <MudTimePicker @bind-Time="_endTime" Label="Endzeit (optional)" Class="mt-2" Disabled="IsBusy" />
    }
</MudForm>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@ErrorMessage</MudAlert>
}

<div class="d-flex align-center mt-4" style="gap:8px;">
    @if (ExistingEvent is not null)
    {
        <MudButton Color="Color.Error" Variant="Variant.Outlined" Disabled="IsBusy" OnClick="() => OnDelete.InvokeAsync()">
            Löschen
        </MudButton>
    }
    <MudSpacer />
    <MudButton Disabled="IsBusy" OnClick="() => OnCancel.InvokeAsync()">Abbrechen</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="IsBusy" OnClick="SaveAsync">
        @if (IsBusy)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Speichern
    </MudButton>
</div>

@code {
    private MudForm? _form;
    private Guid? _initializedForEventId;
    private bool _initializedForCreate;

    private string _summary = "";
    private string? _location;
    private string? _description;
    private bool _isAllDay;
    private DateTime? _date = DateTime.Today;
    private DateRange? _dateRange = new(DateTime.Today, DateTime.Today);
    private TimeSpan? _startTime = DateTime.Now.TimeOfDay;
    private TimeSpan? _endTime;
    private Guid _calendarId;

    [Parameter] public EventDto? ExistingEvent { get; set; }
    [Parameter] public IReadOnlyList<CalendarDto> WritableCalendars { get; set; } = [];
    [Parameter] public EventCallback<(Guid? CalendarId, EventWriteRequest Request)> OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    protected override void OnParametersSet()
    {
        if (ExistingEvent is { } evt)
        {
            if (_initializedForEventId == evt.Id)
            {
                return;
            }
            _initializedForEventId = evt.Id;

            _summary = evt.Summary;
            _location = evt.Location;
            _description = evt.Description;
            _isAllDay = evt.IsAllDay;
            var localStart = evt.StartUtc.LocalDateTime;
            _date = localStart.Date;
            _startTime = localStart.TimeOfDay;
            _endTime = evt.EndUtc?.LocalDateTime.TimeOfDay;
            // EndUtc for an all-day event is the RFC 5545 exclusive end (day after the last day) —
            // shift it back by one to get the inclusive last day the range picker should show.
            var lastDay = evt.IsAllDay ? evt.EndUtc?.LocalDateTime.Date.AddDays(-1) ?? _date.Value : _date.Value;
            _dateRange = new DateRange(_date.Value, lastDay);
        }
        else if (!_initializedForCreate)
        {
            _initializedForCreate = true;
            _date = DateTime.Today;
            _dateRange = new DateRange(DateTime.Today, DateTime.Today);
            _startTime = RoundToNextQuarterHour(DateTime.Now.TimeOfDay);
        }

        if (ExistingEvent is null && _calendarId == Guid.Empty)
        {
            _calendarId = WritableCalendars.FirstOrDefault()?.Id ?? Guid.Empty;
        }
    }

    private void OnIsAllDayChanged(bool value)
    {
        _isAllDay = value;
        if (value)
        {
            _dateRange = new DateRange(_date ?? DateTime.Today, _date ?? DateTime.Today);
        }
        else
        {
            _date = _dateRange?.Start ?? _date;
            if (_startTime is null)
            {
                _startTime = RoundToNextQuarterHour(DateTime.Now.TimeOfDay);
            }
        }
    }

    private static TimeSpan RoundToNextQuarterHour(TimeSpan value)
    {
        var minutes = (int)Math.Ceiling(value.TotalMinutes / 15.0) * 15;
        return TimeSpan.FromMinutes(minutes);
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }
        if (_isAllDay && (_dateRange?.Start is null || _dateRange.End is null))
        {
            return;
        }
        if (!_isAllDay && _date is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        DateTimeOffset startUtc;
        DateTimeOffset? endUtc;
        if (_isAllDay)
        {
            var firstDay = _dateRange!.Start!.Value.Date;
            var lastDay = _dateRange.End!.Value.Date;
            startUtc = ToOffset(firstDay);
            // Single day keeps the historical EndUtc == null shape; a multi-day span sends the RFC 5545
            // exclusive end date (the day after the last selected day) so DTEND comes out correct.
            endUtc = lastDay > firstDay ? ToOffset(lastDay.AddDays(1)) : null;
        }
        else
        {
            var startLocal = _date!.Value.Date + (_startTime ?? TimeSpan.Zero);
            startUtc = ToOffset(startLocal);
            endUtc = _endTime is null ? null : ToOffset(_date.Value.Date + _endTime.Value);
        }

        var calendarId = ExistingEvent is null ? (Guid?)_calendarId : null;
        await OnSave.InvokeAsync((calendarId, new EventWriteRequest(_summary, _location, _description, startUtc, endUtc, _isAllDay)));
    }

    private static DateTimeOffset ToOffset(DateTime local) => new(local, TimeZoneInfo.Local.GetUtcOffset(local));
}
