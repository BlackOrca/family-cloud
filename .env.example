# Copy this file to ".env" next to docker-compose.yaml and fill in real values before
# `docker compose up`. ".env" itself is gitignored — never commit real secrets.

# Set by build.ps1's summary output after each run (see version.json for the current version).
SERVER_IMAGE=familycloud-server:0.1.0
SERVER_PORT=8080

# Any random string works; 32+ characters recommended. Used to sign login tokens — changing it
# invalidates all previously issued tokens.
JWT_SIGNING_KEY=

# Bootstrap credentials for the first admin account. Only used the very first time the server
# starts against an empty database — safe to leave blank afterwards.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
