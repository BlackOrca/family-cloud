# Copy this file to ".env" next to docker-compose.yaml and fill in real values before
# `docker compose up`. ".env" itself is gitignored — never commit real secrets.

# Set by build.ps1's summary output after each run (see version.json for the current version).
SERVER_IMAGE=familycloud-server:0.1.5
SERVER_PORT=8080

# Password for the bundled PostgreSQL container's "postgres" user. Any random string works;
# generate once per deployment and keep it stable — changing it after the volume is initialized
# just breaks the server's connection until it matches again.
POSTGRES_PASSWORD=

# Password for the bundled Immich stack's own, separate PostgreSQL instance (Immich manages its own
# schema there — FamilyCloud.Server never connects to it directly, only to immich-server's REST API).
# Same rules as POSTGRES_PASSWORD above: any random string, generate once, keep it stable.
IMMICH_POSTGRES_PASSWORD=

# Any random string works; 32+ characters recommended. Used to sign login tokens — changing it
# invalidates all previously issued tokens.
JWT_SIGNING_KEY=

# Bootstrap credentials for the first admin account. Only used the very first time the server
# starts against an empty database — safe to leave blank afterwards.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Password for the bundled OpenCloud instance's built-in "admin" account (used only by
# FamilyCloud.Server to provision per-family-member OpenCloud accounts and shared Spaces — see the
# Storage feature). Only used the very first time OpenCloud itself starts; changes afterwards are
# ignored by OpenCloud (its own admin-password-change flow would be needed instead).
OPENCLOUD_ADMIN_PASSWORD=
