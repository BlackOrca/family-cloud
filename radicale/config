# This custom config file replaces the image's default wholesale (see AppHost.cs's bind mount of
# this file to /config/config), which otherwise sets this to 0.0.0.0:5232 for reachability from
# outside the container. Without it Radicale falls back to its own built-in default of
# localhost:5232 (loopback-only), so nothing arriving via Docker's published/bridged port ever
# reaches it — requests get accepted at the TCP/NAT layer and then dropped with no response,
# which surfaces to .NET clients as "The response ended prematurely" (ResponseEnded).
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /auth/users
htpasswd_encryption = bcrypt

[rights]
type = owner_only

# This custom config file replaces the image's default wholesale (see AppHost.cs's bind mount of
# this file to /config/config), which otherwise sets this to /data/collections — matching the /data
# volume already mounted into this container. Without it Radicale falls back to its own built-in
# default of /var/lib/radicale/collections, which the non-root radicale user can't write to.
[storage]
filesystem_folder = /data/collections
